{"updatedAt":"2026-01-28T12:14:14.896Z","createdAt":"2026-01-28T12:06:37.884Z","id":"n0ydlV2b6-2JB1NrUJ7ng","name":"Write Daily Sales To Accounting API","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{},"type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[0,0],"id":"1032d7ac-a4d0-41fb-8355-4cb07a91c03f","name":"When clicking ‘Execute workflow’"},{"parameters":{"jsCode":"const start = new Date();\nstart.setDate(start.getDate() - 1);\nstart.setHours(0, 0, 0, 0);\n\nconst end = new Date(start);\nend.setDate(end.getDate() + 1);\n\nreturn [{\n  json: {\n    start_date: start.toISOString(),\n    end_date: end.toISOString(),\n    sale_date: start.toISOString().slice(0, 10)\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[208,0],"id":"de1e2812-2e1a-4d91-96e5-d2f19c5a1daa","name":"Code in JavaScript"},{"parameters":{"operation":"executeQuery","query":"SELECT\n    DATE(created_at) AS sale_date,\n    COUNT(DISTINCT transaction_id) AS transaction_count,\n    SUM(quantity) AS items_sold,\n    SUM(total_price) AS gross_sales\nFROM sales\nWHERE created_at >= $1\n  AND created_at < $2\nGROUP BY sale_date;","options":{"queryReplacement":"=[{{ $json.start_date}}, {{$json.end_date }}]"}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[416,0],"id":"d36843ba-d45e-41c5-923c-6f36bbac4b76","name":"Execute a SQL query","credentials":{"postgres":{"id":"FrYsXFak1H1yPuzY","name":"Postgres account"}}}],"connections":{"When clicking ‘Execute workflow’":{"main":[[{"node":"Code in JavaScript","type":"main","index":0}]]},"Code in JavaScript":{"main":[[{"node":"Execute a SQL query","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","availableInMCP":false},"staticData":null,"meta":{"templateCredsSetupCompleted":true},"pinData":{},"versionId":"90f4342e-41f5-4837-ab40-ab8efe1d9b9c","activeVersionId":null,"versionCounter":2,"triggerCount":0,"tags":[],"shared":[{"updatedAt":"2026-01-28T12:06:37.891Z","createdAt":"202