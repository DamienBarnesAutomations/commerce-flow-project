[{"updatedAt":"2026-01-01T02:43:19.105Z","createdAt":"2025-12-30T00:12:49.770Z","id":"0pJhqz3JhUsGoGrI","name":"Manage-Store-Products","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"jsCode":"const msg = $input.item.json;\nconst messageData = msg.message || msg.edited_message;\n\nif (!messageData) return [];\n\nconst rawText = messageData.text || messageData.caption || \"\";\nconst cleanText = rawText.trim();\nconst parts = cleanText.split(' ');\n\nif (parts.length >= 2) {\n    const priceStr = parts.pop(); \n    \n    // Capitalize each word properly\n    const name = parts.join(' ')\n        .split(' ')\n        .filter(word => word.length > 0) // Remove extra spaces\n        .map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())\n        .join(' ');\n\n    const price = parseFloat(priceStr.replace(/[^0-9.]/g, '')) || 0;\n\n    return { \n        json: {\n            product_name: name,\n            product_price: price,\n            original_msg_id: messageData.message_id,\n            chat_id: messageData.chat.id,\n            file_id: (messageData.photo && messageData.photo.length > 0) \n                    ? messageData.photo[messageData.photo.length - 1].file_id \n                    : null\n        } \n    };\n}\n\nreturn [];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[608,192],"id":"4f37e7c1-4edc-4d2a-9d1f-a49456ab5938","name":"Code in JavaScript1"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"50f64a89-0f97-479f-bf0e-39c4de3d2717","leftValue":"={{ $json.product_name }}","rightValue":"","operator":{"type":"string","operation":"exists","singleValue":true}},{"id":"65a2456d-2949-427c-b7af-bd7d9d857ab2","leftValue":"={{ $json.product_price }}","rightValue":0,"operator":{"type":"number","operation":"exists","singleValue":true}},{"id":"4a60d692-55c4-403c-a711-33d75813bd9a","leftValue":"={{ $json.file_id }}","right