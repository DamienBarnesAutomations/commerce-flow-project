[{"updatedAt":"2025-12-30T12:25:45.404Z","createdAt":"2025-12-30T00:12:49.770Z","id":"0pJhqz3JhUsGoGrI","name":"Manage-Store-Products","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{"jsCode":"const msg = $input.item.json;\nconst messageData = msg.message || msg.edited_message;\n\nif (!messageData) return [];\n\nconst rawText = messageData.text || messageData.caption || \"\";\nconst cleanText = rawText.trim();\nconst parts = cleanText.split(' ');\n\nif (parts.length >= 2) {\n    const priceStr = parts.pop(); \n    const name = parts.join(' ');\n    const price = parseFloat(priceStr.replace(/[^0-9.]/g, '')) || 0;\n\n    return { \n        json: {\n            product_name: name,\n            product_price: price,\n            original_msg_id: messageData.message_id,\n            chat_id: messageData.chat.id,\n            file_id: (messageData.photo && messageData.photo.length > 0) \n                     ? messageData.photo[messageData.photo.length - 1].file_id \n                     : null\n        } \n    };\n}\n\nreturn [];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[608,192],"id":"4f37e7c1-4edc-4d2a-9d1f-a49456ab5938","name":"Code in JavaScript1"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"50f64a89-0f97-479f-bf0e-39c4de3d2717","leftValue":"={{ $json.product_name }}","rightValue":"","operator":{"type":"string","operation":"exists","singleValue":true}},{"id":"65a2456d-2949-427c-b7af-bd7d9d857ab2","leftValue":"={{ $json.product_price }}","rightValue":0,"operator":{"type":"number","operation":"exists","singleValue":true}},{"id":"4a60d692-55c4-403c-a711-33d75813bd9a","leftValue":"={{ $json.file_id }}","rightValue":"","operator":{"type":"string","operation":"exists","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.3,"position":[864,192],"id":"86eb2bf3-4001-4272-9985-469d376b95ff","name":"If"},{"parameters":{"operation":"executeQuery","query":"INSERT INTO products (name, price, img_url)\nVALUES ('{{ $('Code in JavaScript1').item.json.product_name }}', {{ $('Code in JavaScript1').item.json.product_price }}, '{{ $json.fileName }}')\nON CONFLICT (name) \nDO UPDATE SET \n    price = EXCLUDED.price,\n    img_url = EXCLUDED.img_url,\n    created_at = CURRENT_TIMESTAMP;","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[1728,-96],"id":"cb36b189-5944-4f14-ab57-a9ff040311f6","name":"Execute a SQL query2","credentials":{"postgres":{"id":"KRAp4ZnQUwqoQ0cx","name":"Postgres account"}}},{"parameters":{"updates":["message"],"additionalFields":{}},"type":"n8n-nodes-base.telegramTrigger","typeVersion":1.2,"position":[304,192],"id":"4d1f849a-f497-449a-ad3e-d4b091241bd4","name":"Telegram Trigger","webhookId":"566bceb3-a801-44b1-b692-ff382d6a8ed0","credentials":{"telegramApi":{"id":"m5XJivv5eMk2in3n","name":"Telegram account"}}},{"parameters":{"resource":"file","fileId":"={{ $json.file_id }}","additionalFields":{}},"type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[1072,-96],"id":"e83afd5f-19b6-4cb2-b64d-719f211e80f4","name":"Get a file","webhookId":"5435d2a6-beec-4e8b-b0bf-599cb0de2339","credentials":{"telegramApi":{"id":"m5XJivv5eMk2in3n","name":"Telegram account"}}},{"parameters":{"operation":"write","fileName":"=/home/node/.n8n-files/public/images/{{ $('Code in JavaScript1').item.json.product_name.replace(/\\s+/g, '_').toLowerCase() }}.jpg","options":{}},"type":"n8n-nodes-base.readWriteFile","typeVersion":1.1,"position":[1280,-96],"id":"f65540d7-127e-4a68-bbd8-8cc3d5732498","name":"Read/Write Files from Disk"}],"connections":{"Code in JavaScript1":{"main":[[{"node":"If","type":"main","index":0}]]},"If":{"main":[[{"node":"Get a file","type":"main","index":0}]]},"Telegram Trigger":{"main":[[{"node":"Code in JavaScript1","type":"main","index":0}]]},"Get a file":{"main":[[{"node":"Read/Write Files from Disk","type":"main","index