{"updatedAt":"2026-02-06T14:01:03.124Z","createdAt":"2026-02-05T15:15:20.124Z","id":"3EVWOkkytEvAhMJa","name":"Accounting: Create Account","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"/accounting/createAccount","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-720,-48],"id":"94d3ded1-0e1f-4aa9-9285-50c6790ff752","name":"Webhook","webhookId":"c5468db6-323e-4d83-b34d-365ffd7fe6fa"},{"parameters":{"jsCode":"const { code, name, type, normal_balance, category_id } = $input.first().json.body;\n\nif (!code || !name || !type || !normal_balance|| !category_id) {\n  throw new Error('Missing required fields');\n}\n\nconst validTypes = ['asset','liability','equity','income','expense'];\nconst validBalances = ['debit','credit'];\n\nif (!validTypes.includes(type)) {\n  throw new Error('Invalid account type');\n}\n\nif (!validBalances.includes(normal_balance)) {\n  throw new Error('Invalid normal balance');\n}\n\n// Optional: enforce accounting logic server-side\nif (['asset','expense'].includes(type) && normal_balance !== 'debit') {\n  throw new Error('Assets and expenses must have debit normal balance');\n}\n\nif (['liability','equity','income'].includes(type) && normal_balance !== 'credit') {\n  throw new Error('Liabilities, equity, and income must have credit normal balance');\n}\n\nreturn [{\n  code: code.trim(),\n  name: name.trim(),\n  type,\n  normal_balance, \n  category_id\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-512,-48],"id":"d1e106b3-18c1-4284-bd68-a1ee24695673","name":"Code in JavaScript"},{"parameters":{"operation":"executeQuery","query":"SELECT id\nFROM accounts\nWHERE code = $1;","options":{"queryReplacement":"={{$json.code}}"}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[-304,-48],"id":"6f7df22e-13ae-45f8-a793-6ba2cbaaae96","name":"Execute a SQL query","alwaysOutputData":true,"executeOnce":true,"credentials