{"updatedAt":"2026-02-06T12:58:09.217Z","createdAt":"2026-02-05T02:35:31.537Z","id":"15UIgeZO6YuI8GFWdgYoQ","name":"Accounting: Get Journal Entries","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"path":"accounting/journalEntries","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-64,0],"id":"588214ed-5046-4b17-9cfb-3acbeffce782","name":"Webhook","webhookId":"a7d897e1-23d7-4053-a565-223f444e34f0"},{"parameters":{"operation":"executeQuery","query":"SELECT\n  je.id,\n  je.entry_date,\n  je.reference,\n  je.description,\n  SUM(jl.debit) AS total_debit,\n  SUM(jl.credit) AS total_credit\nFROM journal_entries je\nJOIN journal_lines jl ON jl.journal_entry_id = je.id\nGROUP BY je.id\nORDER BY je.entry_date DESC;","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[192,0],"id":"68465d43-f390-4c13-bf81-0b360c300baf","name":"Execute a SQL query","executeOnce":false,"alwaysOutputData":true,"credentials":{"postgres":{"id":"tdeYwbyCFeBuflzs","name":"Accounting Db Credentials"}}},{"parameters":{"respondWith":"allIncomingItems","options":{"responseCode":200}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[416,0],"id":"1df76de7-d1b8-4a81-b22c-93bf2a3e1924","name":"Respond to Webhook"}],"connections":{"Webhook":{"main":[[{"node":"Execute a SQL query","type":"main","index":0}]]},"Execute a SQL query":{"main":[[{"node":"Respond to Webhook","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","availableInMCP":false},"staticData":null,"meta":null,"pinData":{},"versionId":"c9835ad5-777b-4a36-8030-746c9d1d34af","activeVersionId":"c9835ad5-777b-4a36-8030-746c9d1d34af","versionCounter":41,"triggerCount":1,"tags":[],"shared":[{"updatedAt":"2026-02-06T07:19:15.345Z","createdAt":"2026-02-06T07:19:15.345Z","role":"workflow:owner","workflowId":"15UIgeZO6YuI8GFWdgYoQ","projectId":"o2e9EE3He6VS7T3p","project":{"updatedAt":"2026-02-06T07:07:34.044Z","create