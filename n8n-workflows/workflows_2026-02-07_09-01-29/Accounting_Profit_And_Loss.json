{"updatedAt":"2026-02-06T12:59:07.408Z","createdAt":"2026-02-06T02:15:45.478Z","id":"4SOgOWzc3dLl3Zic","name":"Accounting: Profit and Loss","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"path":"accounting/profitAndLoss","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-64,0],"id":"f242d445-69f1-49d6-ba89-348bf663fbcc","name":"Webhook","webhookId":"0ba9053b-d330-413c-8e4b-81e74124c763"},{"parameters":{"operation":"executeQuery","query":"-- Logic for Profit & Loss Aggregation\nSELECT \n    ac.type,\n    ac.name AS category_name,\n    ac.label AS category_label,\n    a.code,\n    a.name,\n    SUM(CASE \n        WHEN a.type = 'income' THEN (l.credit - l.debit)\n        WHEN a.type = 'expense' THEN (l.debit - l.credit)\n        ELSE 0 \n    END) as balance\nFROM accounts a\nJOIN account_categories ac ON a.category_id = ac.id\nLEFT JOIN journal_lines l ON a.id = l.account_id\nWHERE a.type IN ('income', 'expense')\nGROUP BY ac.type, ac.name, ac.label, a.code, a.name\nORDER BY a.code;\n","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[192,0],"id":"ee4139af-350c-4b30-b48a-9af1b6e2b6f3","name":"Execute a SQL query","executeOnce":false,"alwaysOutputData":true,"credentials":{"postgres":{"id":"tdeYwbyCFeBuflzs","name":"Accounting Db Credentials"}}},{"parameters":{"respondWith":"allIncomingItems","options":{"responseCode":200}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[416,0],"id":"2c32c968-e50d-42e6-8ed2-d77a616acdd2","name":"Respond to Webhook"}],"connections":{"Webhook":{"main":[[{"node":"Execute a SQL query","type":"main","index":0}]]},"Execute a SQL query":{"main":[[{"node":"Respond to Webhook","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","availableInMCP":false},"staticData":null,"meta":{"templateCredsSetupCompleted":true},"pinData":{},"versionId":"5d194d50-af08-49e2-b5e3-0d4e833ec442","activeVersionId":"5d194d50-af08-49e2-b5e3-0d4e833ec442","versionCounter":50,"triggerCount":1,"tags":[],"shared":[{"updatedAt":"2026-02-06T07:19:15.345Z","createdAt":"2026-02-06T07:19:15.345Z","role":"workflow:owner","workflowId":"4SOgOWzc3dLl3Zic","projectId":"o2e9EE3He6VS7T3p","project":{"updatedAt":"2026-02-06T07:07:34.044Z","createdAt":"2026-02-06T06:57:05.066Z","id":"o2e9EE3He6VS7T3p","name":"Damien Barnes <damie3@gmail.com>","type":"personal","icon":null,"description":null,"creatorId":"dba441bf-f730-43f9-aed3-cddcd4259212"}}]}
