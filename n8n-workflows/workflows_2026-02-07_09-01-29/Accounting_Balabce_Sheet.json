{"updatedAt":"2026-02-06T13:01:20.794Z","createdAt":"2026-02-06T02:04:22.904Z","id":"v0ypRfoHb0HThaAI","name":"Accounting: Balabce Sheet","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"path":"accounting/balanceSheet","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-64,0],"id":"fd6fa06b-2772-4d67-bd65-09dbd5cd1fd1","name":"Webhook","webhookId":"e49a5ce1-931e-4665-9f7e-5ae997e21c05"},{"parameters":{"operation":"executeQuery","query":"-- Logic for Balance Sheet Aggregation\nSELECT \n    ac.type,\n    ac.label AS category_label,\n    a.code,\n    a.name,\n    -- Calculate Net Balance: (Debit - Credit) for Assets/Expenses, (Credit - Debit) for others\n    SUM(CASE \n        WHEN a.normal_balance = 'debit' THEN (l.debit - l.credit)\n        ELSE (l.credit - l.debit)\n    END) as balance\nFROM accounts a\nJOIN account_categories ac ON a.category_id = ac.id\nLEFT JOIN journal_lines l ON a.id = l.account_id\nWHERE a.type IN ('asset', 'liability', 'equity')\nGROUP BY ac.type, ac.label, a.code, a.name\nORDER BY a.code;\n","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[192,0],"id":"e6488a45-2606-4d6b-9848-21158d0f99be","name":"Execute a SQL query","executeOnce":false,"alwaysOutputData":true,"credentials":{"postgres":{"id":"tdeYwbyCFeBuflzs","name":"Accounting Db Credentials"}}},{"parameters":{"respondWith":"allIncomingItems","options":{"responseCode":200}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[416,0],"id":"2d2298c6-0495-45ff-91e1-10ac2ba2e1b6","name":"Respond to Webhook"}],"connections":{"Webhook":{"main":[[{"node":"Execute a SQL query","type":"main","index":0}]]},"Execute a SQL query":{"main":[[{"node":"Respond to Webhook","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","availableInMCP":false},"staticData":null,"meta":{"templateCredsSetupCompleted":true},"pinData":{},"versionId":"afda8192-6221-4b0f-bccc-c394073e962d","activeVersionId":"afda8192-6221-4b0f-bccc-c394073e962d","versionCounter":47,"triggerCount":1,"tags":[],"shared":[{"updatedAt":"2026-02-06T07:19:15.345Z","createdAt":"2026-02-06T07:19:15.345Z","role":"workflow:owner","workflowId":"v0ypRfoHb0HThaAI","projectId":"o2e9EE3He6VS7T3p","project":{"updatedAt":"2026-02-06T07:07:34.044Z","createdAt":"2026-02-06T06:57:05.066Z","id":"o2e9EE3He6VS7T3p","name":"Damien Barnes <damie3@gmail.com>","type":"personal","icon":null,"description":null,"creatorId":"dba441bf-f730-43f9-aed3-cddcd4259212"}}]}
