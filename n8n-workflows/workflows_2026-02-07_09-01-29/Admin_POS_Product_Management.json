{"updatedAt":"2026-02-07T08:20:24.825Z","createdAt":"2026-01-01T11:36:43.799Z","id":"0wa4N0Q7hcY4hwlK","name":"Admin: POS: Product Management","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"jsCode":"const body = $input.first().json.body;\nconst messageData = body.message \n\nif (!messageData) return [];\n\nconst rawText = messageData || \"\";\nconst cleanText = rawText.trim();\nconst parts = cleanText.split(' ');\n\nif (parts[0].toLowerCase() === 'add') {\n  parts.shift(); // Remove the \"add\" command from the array\n  \n  if (parts.length >= 2) {\n    const priceStr = parts.pop(); \n    \n    // Capitalize each word properly\n    const name = parts.join(' ')\n        .split(' ')\n        .filter(word => word.length > 0) // Remove extra spaces\n        .map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())\n        .join(' ');\n\n    const price = parseFloat(priceStr.replace(/[^0-9.]/g, '')) || 0;\n    const product_file = \"products/\" + name.replace(/\\s+/g, '_').toLowerCase() +\".jpg\"\n\n    return { \n            product_name: name,\n            product_price: price,\n            product_file: product_file, \n            body : $input.first().json.body\n    };\n  }\n}\n\nreturn [];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-64,-48],"id":"02da0acf-3b3f-42c6-baff-ea82e9d49863","name":"Code in JavaScript1"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"50f64a89-0f97-479f-bf0e-39c4de3d2717","leftValue":"={{ $json.product_name }}","rightValue":"","operator":{"type":"string","operation":"exists","singleValue":true}},{"id":"65a2456d-2949-427c-b7af-bd7d9d857ab2","leftValue":"={{ $json.product_price }}","rightValue":0,"operator":{"type":"number","operation":"exists","singleValue":true}},{"id":"4a60d692-55c4-403c-a711-33d75813bd9a","leftValue":"={{ $json.body.filename }}","rightValue":"","operator":{"type":"string","o