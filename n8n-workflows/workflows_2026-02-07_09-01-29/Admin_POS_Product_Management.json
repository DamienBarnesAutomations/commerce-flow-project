"id":"aa89c59c-6ed0-4ae0-b755-2680ae20de09","name":"Select rows from a table","credentials":{"postgres":{"id":"LleDUwLucS7vZHjv","name":"POS DB Credentials"}}},{"parameters":{"jsCode":"// Get all items from the previous node (Postgres Select)\nconst items = $input.all();\n\nif (items.length === 0) {\n  return {\n    json: {\n      message: \"📦 *Inventory is empty.*\\nUse 'add [name] [price]' to get started.\"\n      \n    }\n  };\n}\n\n// Build the header\nlet listMessage = \"📦 *Current Inventory*\\n\";\nlistMessage += \"━━━━━━━━━━━━━━━\\n\";\n\n// Loop through items and format each line\nitems.forEach((item, index) => {\n  const p = item.json;\n  // Format price to 2 decimal places\n  const formattedPrice = Number(p.price).toFixed(2);\n  \n  // Create a clean row: 1. Carrot Cake - €15.00\n  listMessage += `${index + 1}. *${p.name}* - €${formattedPrice}\\n`;\n});\n\nlistMessage += \"━━━━━━━━━━━━━━━\\n\";\nlistMessage += `Total: ${items.length} products`;\n\nreturn {\n    response_message: listMessage\n};"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[752,176],"id":"01d9527b-5df2-4b30-abfa-73cc7ff3a5d4","name":"Code in JavaScript2"},{"parameters":{"jsCode":"const msg = $('Code in JavaScript').first().json.telegram\nconst messageData = msg.telegram \n\nif (!messageData) return [];\n\nconst rawText = messageData.text || messageData.caption || \"\";\nconst cleanText = rawText.trim();\nconst parts = cleanText.split(/\\s+/);\n\n// 1. Check if the command is 'update'\nif (parts[0].toLowerCase() === 'update') {\n    parts.shift(); // Remove 'update'\n    \n    if (parts.length >= 2) {\n        // 2. Extract price (the last word)\n        const priceStr = parts.pop(); \n        const newPrice = parseFloat(priceStr.replace(/[^0-9.]/g, '')) || 0;\n\n        // 3. Extract and Format Name (everything else in the middle)\n        const targetName = parts\n            .map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())\n            .join(' ');\n\n        return { \n            json: {\n                command: 'update',\n                product_name: targetName,\n                new_price: newPrice,\n                chat_id: messageData.chat.id\n            } \n        };\n    }\n}\n\nreturn { json: { error: \"Format must be: update [name] [price]\" } };"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[16,352],"id":"08ac1c97-4891-404e-82b5-d586d08c3cc3","name":"Code in JavaScript3"},{"parameters":{"operation":"update","schema":{"__rl":true,"mode":"list","value":"public"},"table":{"__rl":true,"value":"products","mode":"list","cachedResultName":"products"},"columns":{"mappingMode":"defineBelow","value":{"price":"={{ $json.new_price }}","name":"={{ $json.product_name }}"},"matchingColumns":["name"],"schema":[{"id":"id","displayName":"id","required":false,"defaultMatch":true,"display":true,"type":"number","canBeUsedToMatch":true,"removed":true},{"id":"name","displayName":"name","required":true,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"price","displayName":"price","required":false,"defaultMatch":false,"display":true,"type":"number","canBeUsedToMatch":true},{"id":"img_url","displayName":"img_url","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":true},{"id":"description","displayName":"description","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":true},{"id":"created_at","displayName":"created_at","required":false,"defaultMatch":false,"display":true,"type":"dateTime","canBeUsedToMatch":true,"removed":true}],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[320,352],"id":"fc2d8200-23cb-4c59-8baa-744800297540","name":"Update rows in a table","credentials":{"postgres":{"id":"LleDUwLucS7vZHjv","name":"POS DB Credentials"}}},{"parameters":{"jsCode":"const msg = $input.first().json.telegram;\nconst messageData = msg.telegram\n\nif (!messageData) return [];\n\nconst rawText = messageData.text || messageData.caption || \"\";\nconst cleanText = rawText.trim();\nconst parts = cleanText.split(/\\s+/);\n\n// 1. Check if the command is 'delete'\nif (parts[0].toLowerCase() === 'delete') {\n    parts.shift(); // Remove 'delete' word\n    \n    if (parts.length >= 1) {\n        // 2. Everything left is the name (handle multi-word names)\n        const targetName = parts\n            .map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())\n            .join(' ');\n\n        return { \n            json: {\n                command: 'delete',\n                product_name: targetName,\n                chat_id: messageData.chat.id,\n                original_msg_id: messageData.message_id\n            } \n        };\n    }\n}\n\n// Return error if they just typed \"delete\" without a name\nreturn { json: { error: \"Format must be: delete [product name]\" } };"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[64,576],"id":"c2915a88-6561-450b-9d87-16271e93d00e","name":"Code in JavaScript4"},{"parameters":{"operation":"executeQuery","query":"SELECT COUNT(*) as sale_count \nFROM products p\nINNER JOIN sales s on s.product_id = p.id\nWHERE p.name = '{{ $json.product_name }}';","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[320,576],"id":"196637d8-dc33-4016-8a66-032c2c134b93","name":"Execute a SQL query","credentials":{"postgres":{"id":"LleDUwLucS7vZHjv","name":"POS DB Credentials"}}},{"parameters":{"operation":"update","schema":{"__rl":true,"mode":"list","value":"public"},"table":{"__rl":true,"value":"products","mode":"list","cachedResultName":"products"},"columns":{"mappingMode":"defineBelow","value":{"is_active":false,"name":"={{ $('Code in JavaScript4').item.json.product_name }}"},"matchingColumns":["name"],"schema":[{"id":"id","displayName":"id","required":false,"defaultMatch":true,"di