{"updatedAt":"2026-02-06T13:01:40.231Z","createdAt":"2026-02-05T14:56:02.593Z","id":"v93sCRSbTat9SiUp","name":"Accounting: Get Trial Balance","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"path":"/accounting/trialBalance","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,0],"id":"b0440aa3-7279-4077-82dd-f5301b4d4c2a","name":"Webhook","webhookId":"0254d0b3-ec3e-4461-b1c4-e536cbf0a23b"},{"parameters":{"operation":"executeQuery","query":"SELECT\n  a.id            AS account_id,\n  a.code          AS code,\n  a.name          AS name,\n  COALESCE(SUM(jl.debit), 0)  AS debit,\n  COALESCE(SUM(jl.credit), 0) AS credit\nFROM accounts a\nLEFT JOIN journal_lines jl\n  ON jl.account_id = a.id\nLEFT JOIN journal_entries je\n  ON je.id = jl.journal_entry_id\nGROUP BY a.id, a.code, a.name\nORDER BY a.code;","options":{"queryReplacement":""}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[208,0],"id":"8f4ef04e-aebb-48d6-975c-847208ad14eb","name":"Execute a SQL query","alwaysOutputData":true,"credentials":{"postgres":{"id":"tdeYwbyCFeBuflzs","name":"Accounting Db Credentials"}}},{"parameters":{"respondWith":"allIncomingItems","options":{"responseCode":200}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[416,0],"id":"b40dc7bb-7257-4df9-bd83-6ff40ccaa4d5","name":"Respond to Webhook"}],"connections":{"Webhook":{"main":[[{"node":"Execute a SQL query","type":"main","index":0}]]},"Execute a SQL query":{"main":[[{"node":"Respond to Webhook","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","availableInMCP":false},"staticData":null,"meta":{"templateCredsSetupCompleted":true},"pinData":{},"versionId":"c86a0075-5842-48d3-abf6-3296d40e6cf2","activeVersionId":"c86a0075-5842-48d3-abf6-3296d40e6cf2","versionCounter":30,"triggerCount":1,"tags":[],"shared":[{"updatedAt":"2026-02-06T07:19:15.345Z","createdAt":"2026-02-06T07:19:15.345Z","role":"workflow:owner","