').item.json.product_price }}","additionalFields":{"appendAttribution":false}},"type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[1584,208],"id":"42e87c79-084a-483f-8aa5-989c1e4917c1","name":"Send a text message","webhookId":"e3d12a9f-fbb3-4198-8bb5-a3744c60ed28","credentials":{"telegramApi":{"id":"rRnPTGRZczU6YvTD","name":"Telegram account"}}},{"parameters":{"jsCode":"const msg = $input.item.json;\nconst messageData = msg.telegram\n\nif (!messageData) return [];\n\nconst rawText = messageData.text || messageData.caption || \"\";\nconst cleanText = rawText.trim();\nconst parts = cleanText.split(' ');\n\nreturn {\"function\": parts[0].toLowerCase(), \n        \"telegram\": msg\n       }"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-544,528],"id":"440a2e41-e70d-404f-ba77-d09e26c1cd09","name":"Code in JavaScript"},{"parameters":{"operation":"select","schema":{"__rl":true,"mode":"list","value":"public"},"table":{"__rl":true,"value":"products","mode":"list","cachedResultName":"products"},"returnAll":true,"options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[192,384],"id":"aa89c59c-6ed0-4ae0-b755-2680ae20de09","name":"Select rows from a table","credentials":{"postgres":{"id":"FrYsXFak1H1yPuzY","name":"Postgres account"}}},{"parameters":{"jsCode":"// Get all items from the previous node (Postgres Select)\nconst items = $input.all();\n\nif (items.length === 0) {\n  return {\n    json: {\n      message: \"📦 *Inventory is empty.*\\nUse 'add [name] [price]' to get started.\"\n      \n    }\n  };\n}\n\n// Build the header\nlet listMessage = \"📦 *Current Inventory*\\n\";\nlistMessage += \"━━━━━━━━━━━━━━━\\n\";\n\n// Loop through items and format each line\nitems.forEach((item, index) => {\n  const p = item.json;\n  // Format price to 2 decimal places\n  const formattedPrice = Number(p.price).toFixed(2);\n  \n  // Create a clean row: 1. Carrot Cake - €15.00\n  listMessage += `${index + 1}. *${p.name}* - €${formattedPrice}\\n`;\n});\n\nlistMessage += \"━━━━━━━━━━━━━━━\\n\";\nlistMessage += `Total: ${items.length} products`;\n\nreturn {\n  json: {\n    message: listMessage\n  }\n};"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[448,384],"id":"01d9527b-5df2-4b30-abfa-73cc7ff3a5d4","name":"Code in JavaScript2"},{"parameters":{"chatId":"={{ $('Switch1').first().json.telegram.telegram.chat.id }}","text":"={{ $json.message }}","additionalFields":{"appendAttribution":false}},"type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[912,384],"id":"c3bb887d-e30b-4fda-87d4-846b830edd5a","name":"Send a text message1","webhookId":"c56b2306-df91-4d5c-95ad-b9722f07cf68","credentials":{"telegramApi":{"id":"rRnPTGRZczU6YvTD","name":"Telegram account"}}},{"parameters":{"jsCode":"const msg = $('Code in JavaScript').first().json.telegram\nconst messageData = msg.telegram \n\nif (!messageData) return [];\n\nconst rawText = messageData.text || messageData.caption || \"\";\nconst cleanText = rawText.trim();\nconst parts = cleanText.split(/\\s+/);\n\n// 1. Check if the command is 'update'\nif (parts[0].toLowerCase() === 'update') {\n    parts.shift(); // Remove 'update'\n    \n    if (parts.length >= 2) {\n        // 2. Extract price (the last word)\n        const priceStr = parts.pop(); \n        const newPrice = parseFloat(priceStr.replace(/[^0-9.]/g, '')) || 0;\n\n        // 3. Extract and Format Name (everything else in the middle)\n        const targetName = parts\n            .map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())\n            .join(' ');\n\n        return { \n            json: {\n                command: 'update',\n                product_name: targetName,\n                new_price: newPrice,\n                chat_id: messageData.chat.id\n            } \n        };\n    }\n}\n\nreturn { json: { error: \"Format must be: update [name] [price]\" } };"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[304,576],"id":"08ac1c97-4891-404e-82b5-d586d08c3cc3",