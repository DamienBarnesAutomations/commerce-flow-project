{"updatedAt":"2026-01-16T22:41:42.422Z","createdAt":"2026-01-01T11:36:43.799Z","id":"0wa4N0Q7hcY4hwlK","name":"Sub: Product Management","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"jsCode":"const msg = $input.first().json.telegram;\nconst messageData = msg.telegram \n\nif (!messageData) return [];\n\nconst rawText = messageData.text || messageData.caption || \"\";\nconst cleanText = rawText.trim();\nconst parts = cleanText.split(' ');\n\nif (parts[0].toLowerCase() === 'add') {\n  parts.shift(); // Remove the \"add\" command from the array\n  \n  if (parts.length >= 2) {\n    const priceStr = parts.pop(); \n    \n    // Capitalize each word properly\n    const name = parts.join(' ')\n        .split(' ')\n        .filter(word => word.length > 0) // Remove extra spaces\n        .map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())\n        .join(' ');\n\n    const price = parseFloat(priceStr.replace(/[^0-9.]/g, '')) || 0;\n\n    return { \n        json: {\n            product_name: name,\n            product_price: price,\n            original_msg_id: messageData.message_id,\n            chat_id: messageData.chat.id,\n            file_id: (messageData.photo && messageData.photo.length > 0) \n                    ? messageData.photo[messageData.photo.length - 1].file_id \n                    : null\n        } \n    };\n  }\n}\n\nreturn [];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-16,224],"id":"02da0acf-3b3f-42c6-baff-ea82e9d49863","name":"Code in JavaScript1"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"50f64a89-0f97-479f-bf0e-39c4de3d2717","leftValue":"={{ $json.product_name }}","rightValue":"","operator":{"type":"string","operation":"exists","singleValue":true}},{"id":"65a2456d-2949-427c-b7af-bd7d9d857ab2","leftValue":"={{ $json.product_price }}","rightValue":0,"operator":{"type":"number","operation":"exists",