{"updatedAt":"2026-02-06T03:55:49.850Z","createdAt":"2026-02-05T02:32:10.734Z","id":"dBx-aG44IM59DT9e4pYe1","name":"Accounting: Add Journal Entry","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"accounting/journalEntry","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-720,-48],"id":"953b6b0e-0112-46cf-842c-306414acbc9f","name":"Webhook","webhookId":"acf52dfd-b7c5-4338-9b01-3d9bd15d283b"},{"parameters":{"jsCode":"const body = $input.first().json.body;\nconst lines = body.lines;\n\nif (!lines || lines.length < 2) {\n  throw new Error('Journal entry must have at least 2 lines');\n}\n\nlet debit = 0;\nlet credit = 0;\n\nfor (const l of lines) {\n  debit += Number(l.debit || 0);\n  credit += Number(l.credit || 0);\n}\n\n// FIX: Use Math.abs and a tiny tolerance (0.001) to account for float precision\nconst difference = Math.abs(debit - credit);\n\nif (difference > 0.001) {\n  throw new Error(`Entry not balanced (debit ${debit.toFixed(2)}, credit ${credit.toFixed(2)})`);\n}\n\nreturn body;\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-512,-48],"id":"7a6126bb-32ce-45e0-be5b-8370205f5910","name":"Code in JavaScript"},{"parameters":{"operation":"executeQuery","query":"INSERT INTO journal_entries (entry_date, reference, description)\nVALUES ($1, COALESCE($2, NULL), COALESCE($3, NULL))\nRETURNING id;","options":{"queryReplacement":"={{ [$json.date, $json.reference || null, $json.description || null]}}"}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[-304,-48],"id":"729a1711-2f68-4fe2-81b9-593b30e9b65f","name":"Execute a SQL query","credentials":{"postgres":{"id":"Xei9j8yWCyjpIU14","name":"Accounting DB"}}},{"parameters":{"jsCode":"const items = $('Code in JavaScript').first().json.lines;\nconst entryId = $input.first().json.id;\n\nconst lines = items.map(i => ({\n    // Use null (no quotes) so JSON.stringify handles it correctly\n    account_id: i.account_id || null, \n    debit: i.debit || 0,\n    credit: i.credit || 0,\n    journal_entry_id: entryId\n}));\n\nreturn {\n  json_data: JSON.stringify(lines)\n};\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-96,-48],"id":"f2e6a392-18a8-4a06-a9a6-e657d404bec8","name":"Code in JavaScript1"},{"parameters":{"respondWith":"noData","options":{"responseCode":200}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[320,-48],"id":"894c24f9-6d5d-4dfd-82f9-5817bab40b79","name":"Respond to Webhook"},{"parameters":{"operation":"executeQuery","query":"INSERT INTO journal_lines (journal_entry_id, account_id, debit, credit)\nSELECT \n    (elem->>'journal_entry_id')::uuid,\n    (elem->>'account_id')::uuid,\n    (elem->>'debit')::numeric,\n    (elem->>'credit')::numeric\nFROM jsonb_array_elements($1::jsonb) AS elem;\n","options":{"queryReplacement":"={{ $json.json_data}}\n"}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[112,-48],"id":"830d6ffc-9b1a-4fe8-a7fa-d9bac5b26700","name":"Execute a SQL query1","executeOnce":true,"credentials":{"postgres":{"id":"Xei9j8yWCyjpIU14","name":"Accounting DB"}}}],"connections":{"Webhook":{"main":[[{"node":"Code in JavaScript","type":"main","index":0}]]},"Code in JavaScript":{"main":[[{"node":"Execute a SQL query","type":"main","index":0}]]},"Execute a SQL query":{"main":[[{"node":"Code in JavaScript1","type":"main","index":0}]]},"Code in JavaScript1":{"main":[[{"node":"Execute a SQL query1","type":"main","index":0}]]},"Execute a SQL query1":{"main":[[{"node":"Respond to Webhook","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","availableInMCP":false},"staticData":null,"meta":null,"pinData":{"Webhook":[{"json":{"headers":{"connection":"keep-alive","host":"n8n-precious.duckdns.org","x-forwarded-scheme":"https","x-forwarded-proto":"https","x-forwarded-for":"112.198.229.20","x-real-ip":"112.198.229.20","content-length":"215","sec-ch-ua-platform":"\"Android\"","user-agen