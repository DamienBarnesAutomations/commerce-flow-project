    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet output = [];\n\n// Loop through every message Telegram returned\nfor (const item of items) {\n    const messages = item.json.result || [];\n    \n    for (const msg of messages) {\n        if (msg.message && msg.message.text) {\n            const rawText = msg.message.text.trim();\n            const parts = rawText.split(' ');\n\n            // Validation: Ensure there are at least two parts (Name and Price)\n            if (parts.length >= 2) {\n                const priceStr = parts.pop(); // Take the last word as the price\n                const name = parts.join(' '); // Join the rest as the name\n                \n                output.push({\n                    json: {\n                        product_name: name,\n                        product_price: parseFloat(priceStr.replace(/[^0-9.]/g, '')) || 0,\n                        original_msg_id: msg.message.message_id,\n                        chat_id: msg.message.chat.id\n                    }\n                });\n            }\n        }\n    }\n}\n\nreturn output;"
      },
